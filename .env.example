# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=false

# Frontend Configuration
FRONTEND_PORT=8501
BACKEND_URL=http://fastapi:8000

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Security
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=60
API_KEY_REQUIRED=false

# Data Paths (for Docker - files are in the backend/frontend directories)
MODEL_PATH=model_saved.pkl
DATA_PATH=reduced_train.csv
EXPLAINER_PATH=explainer.pkl
SHAP_VALUES_PATH=shap_values.pkl

# Database (optional - for future enhancement)
# DATABASE_URL=postgresql://user:password@localhost:5432/credit_scoring

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
